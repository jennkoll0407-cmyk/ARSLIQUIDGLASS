<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient android:angle="90" android:startColor="#9AFFFFFF" android:centerColor="#55DCE8F5" android:endColor="#603B9DFF"/>
            <stroke android:width="2dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#16FFFFFF"/>
            <stroke android:width="1dp" android:color="#80FFFFFF"/>
        </shape>
    </item>
</layer-list>