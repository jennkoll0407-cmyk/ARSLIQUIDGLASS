<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:type="radial" android:gradientRadius="42dp" android:centerX="0.06" android:centerY="0.04" android:startColor="#42FFFFFF" android:centerColor="#06FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="270" android:startColor="#30202A35" android:centerColor="#10202A35" android:endColor="#00202A35" />
        </shape>
    </item>
    <item android:left="3dp" android:top="1dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:type="radial" android:gradientRadius="26dp" android:centerX="0.88" android:centerY="0.08" android:startColor="#30FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Contour-following surface strip and full perimeter rim. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:type="radial" android:gradientRadius="24dp" android:centerX="0.5" android:centerY="0.02" android:startColor="#28FFFFFF" android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</layer-list>
