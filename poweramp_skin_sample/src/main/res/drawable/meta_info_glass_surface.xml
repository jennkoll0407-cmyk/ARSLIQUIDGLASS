<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glass shell and bright polished rim. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ars_glass" />
            <stroke android:width="1.5dp" android:color="@color/ars_glass_border" />
        </shape>
    </item>
    <!-- Convex top surface: bright at the top, fading into transparent glass. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="90"
                android:startColor="#66FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Internal volume gradient: slight depth and darker lower edge. -->
    <item android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270"
                android:startColor="#00FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#25202A35" />
        </shape>
    </item>
    <!-- Narrow inner bevel catches light separately from the outer border. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00FFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <!-- Broad curved sheen across the upper-left face. -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="315"
                android:startColor="#30FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
