<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Borderless translucent glass body; depth comes from light and shade, not strokes. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <!-- Soft outer-edge reflection, inset to follow the rounded contour. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="270"
                android:startColor="#70FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#30202A35" />
        </shape>
    </item>
    <!-- Convex upper highlight fades naturally into the transparent face. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="90"
                android:startColor="#58FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Internal lower shading gives the surface volume without drawing an outline. -->
    <item android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270"
                android:startColor="#00FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#25202A35" />
        </shape>
    </item>
    <!-- Very subtle diagonal sheen; no stroke or hard inner border. -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315"
                android:startColor="#26FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#0CFFFFFF" />
        </shape>
    </item>
</layer-list>
