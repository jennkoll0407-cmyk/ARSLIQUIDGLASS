<?xml version="1.0" encoding="utf-8"?>

<!-- ARS Liquid Glass: translucent navy surface, subtle edge and cool blue touch feedback. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#553AAEFF">

    <!-- Persistent glass surface -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#35FFFFFF"
                android:centerColor="#201C3550"
                android:endColor="#50101F33"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

    <!-- Keep ripple clipped to the rounded glass silhouette -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
