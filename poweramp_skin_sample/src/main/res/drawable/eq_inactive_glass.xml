<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ars_glass" />
            <stroke android:width="1.5dp" android:color="@color/ars_glass_border" />
        </shape>
    </item>
    <!-- Bright convex top reflection. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="90"
                android:startColor="#70FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Soft internal shadow to add perceived volume without clouding the center. -->
    <item android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270"
                android:startColor="#00FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#28202A35" />
        </shape>
    </item>
    <!-- Thin inner bevel highlight. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00FFFFFF" />
            <stroke android:width="1dp" android:color="#72FFFFFF" />
        </shape>
    </item>
    <!-- Diagonal glass reflection with a restrained lower-right rim glow. -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="315"
                android:startColor="#38FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
