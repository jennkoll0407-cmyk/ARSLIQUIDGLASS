<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Same liquid-glass layers as the regular glass, with a darker translucent body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient android:angle="90" android:startColor="#30FFFFFF" android:centerColor="#18DCE8F5" android:endColor="#60232D3A"/>
            <stroke android:width="1.5dp" android:color="#A6FFFFFF"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <gradient android:angle="90" android:startColor="#28FFFFFF" android:centerColor="#0CFFFFFF" android:endColor="#00FFFFFF"/>
            <stroke android:width="1dp" android:color="#35FFFFFF"/>
        </shape>
    </item>
</layer-list>