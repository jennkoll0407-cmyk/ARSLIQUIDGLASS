<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient android:angle="90" android:startColor="#30FFFFFF" android:centerColor="#18212A32" android:endColor="#C010141A"/>
            <stroke android:width="1.5dp" android:color="#78FFFFFF"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <solid android:color="#18000000"/>
            <stroke android:width="1dp" android:color="#30FFFFFF"/>
        </shape>
    </item>
</layer-list>