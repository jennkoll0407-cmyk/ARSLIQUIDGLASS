<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <!-- Soft highlight follows the rounded perimeter with no hard outline. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="270"
                android:startColor="#78FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#30202A35" />
        </shape>
    </item>
    <!-- Convex top reflection. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="90"
                android:startColor="#60FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Subtle internal shadow builds depth without adding a border line. -->
    <item android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270"
                android:startColor="#00FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#28202A35" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315"
                android:startColor="#28FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
</layer-list>
