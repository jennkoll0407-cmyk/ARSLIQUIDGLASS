<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient android:angle="270" android:startColor="#A8FFFFFF" android:centerColor="#12FFFFFF" android:endColor="#38202A35" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient android:type="radial" android:gradientRadius="86dp" android:centerX="0.08" android:centerY="0.06" android:startColor="#A8FFFFFF" android:centerColor="#32FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="97dp" />
            <gradient android:angle="90" android:startColor="#60FFFFFF" android:centerColor="#18FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
