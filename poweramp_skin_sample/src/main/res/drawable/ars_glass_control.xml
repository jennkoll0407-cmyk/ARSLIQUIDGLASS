<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient android:angle="90" android:startColor="#42FFFFFF" android:centerColor="#06FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#06202A35" android:endColor="#30202A35" />
        </shape>
    </item>
    <item android:left="3dp" android:top="1dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="97dp" />
            <gradient android:angle="90" android:startColor="#30FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>