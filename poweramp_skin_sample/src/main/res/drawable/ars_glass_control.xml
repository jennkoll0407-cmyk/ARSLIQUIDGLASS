<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient android:type="radial" android:gradientRadius="42dp" android:centerX="0.06" android:centerY="0.04" android:startColor="#42FFFFFF" android:centerColor="#06FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#06202A35" android:endColor="#30202A35" />
        </shape>
    </item>
    <item android:left="3dp" android:top="1dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="97dp" />
            <gradient android:type="radial" android:gradientRadius="26dp" android:centerX="0.88" android:centerY="0.08" android:startColor="#30FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>


    <!-- Rounded bubble rim strips; each strip follows the drawable's own contour. -->
    <item android:height="4dp" android:gravity="top" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient android:angle="270" android:startColor="#42FFFFFF" android:centerColor="#18FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:height="3dp" android:gravity="bottom" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient android:angle="90" android:startColor="#00202A35" android:centerColor="#18202A35" android:endColor="#30202A35" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="left" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient android:angle="0" android:startColor="#20FFFFFF" android:centerColor="#08202A35" android:endColor="#00202A35" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="right" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient android:angle="0" android:startColor="#00202A35" android:centerColor="#08202A35" android:endColor="#20FFFFFF" />
        </shape>
    </item>
</layer-list>