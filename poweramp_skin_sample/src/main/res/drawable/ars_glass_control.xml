<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted translucent body -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:centerColor="#30DCE8F5"
                android:endColor="#38232D3A" />
            <stroke
                android:width="1.5dp"
                android:color="#D9FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <!-- Inner reflective rim -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#42FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
