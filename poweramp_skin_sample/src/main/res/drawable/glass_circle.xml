<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#A8FFFFFF" android:centerColor="#12FFFFFF" android:endColor="#38202A35" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60dp" android:centerX="0.20" android:centerY="0.16" android:startColor="#B8FFFFFF" android:centerColor="#30FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="@color/ars_glass_highlight" android:centerColor="#18FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
