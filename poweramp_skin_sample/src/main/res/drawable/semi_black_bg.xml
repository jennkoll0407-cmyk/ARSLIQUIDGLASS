<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="rectangle">
			<solid android:color="@color/ars_glass"/>
			<stroke android:width="1.5dp" android:color="@color/ars_glass_border"/>
			<corners android:radius="16dp"/>
		</shape>
	</item>
	<item
		android:left="2dp"
		android:top="1dp"
		android:right="2dp"
		android:bottom="5dp">
		<shape android:shape="rectangle">
			<corners android:radius="14dp"/>
			<gradient
				android:angle="90"
				android:startColor="@color/ars_glass_highlight"
				android:centerColor="#10FFFFFF"
				android:endColor="#00FFFFFF"/>
		</shape>
	</item>
</layer-list>
