<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <gradient android:type="radial" android:gradientRadius="42dp" android:centerX="0.06" android:centerY="0.04" android:startColor="#42FFFFFF" android:centerColor="#06FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <gradient android:angle="270" android:startColor="#30202A35" android:centerColor="#10202A35" android:endColor="#00202A35" />
        </shape>
    </item>
    <item android:left="3dp" android:top="1dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="33dp" />
            <gradient android:type="radial" android:gradientRadius="26dp" android:centerX="0.88" android:centerY="0.08" android:startColor="#30FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Thin oval rim highlights with fully rounded ends. -->
    <item android:left="12dp" android:top="1dp" android:right="12dp" android:height="4dp" android:gravity="top">
        <shape android:shape="oval">
            <corners android:radius="100dp" />
            <gradient android:angle="270" android:startColor="#42FFFFFF" android:centerColor="#18FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="12dp" android:bottom="2dp" android:right="12dp" android:height="3dp" android:gravity="bottom">
        <shape android:shape="oval">
            <corners android:radius="100dp" />
            <gradient android:angle="270" android:startColor="#00202A35" android:centerColor="#18202A35" android:endColor="#30202A35" />
        </shape>
    </item>
</layer-list>
