<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cool, translucent glass body with a subtle smoky lower edge -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#55FFFFFF"
                android:centerColor="#32DCE8F5"
                android:endColor="#25232D3A" />
            <stroke
                android:width="1dp"
                android:color="#BFFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Inner glass reflection -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#38FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#35FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- Bottom rim gives the floating capsule a glass-like edge -->
    <item
        android:top="5dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00FFFFFF"
                android:endColor="#24FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
