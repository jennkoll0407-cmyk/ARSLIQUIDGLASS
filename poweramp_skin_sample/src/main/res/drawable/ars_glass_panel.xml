<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="@color/ars_glass" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <gradient android:angle="270" android:startColor="#88FFFFFF" android:centerColor="#12FFFFFF" android:endColor="#30232D3A" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <gradient android:type="radial" android:gradientRadius="120dp" android:centerX="0.08" android:centerY="0.04" android:startColor="#98FFFFFF" android:centerColor="#26FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="33dp" />
            <gradient android:angle="90" android:startColor="#50FFFFFF" android:centerColor="#12FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <gradient android:type="radial" android:gradientRadius="130dp" android:centerX="0.94" android:centerY="0.96" android:startColor="#38202A35" android:centerColor="#14202A35" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
